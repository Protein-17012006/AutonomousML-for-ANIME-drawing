# Copy to infra/params.env (GIT-IGNORED) and fill in. Values marked (lookup) have the
# exact lookup command in infra/README.md.
REGION=ap-southeast-1
APP_DOMAIN=copilot.example.click          # the Route53-registered domain (design: ~$3 .click)
HOSTED_ZONE_ID=Z0000000000000             # (lookup) Route53 hosted zone of APP_DOMAIN's parent
HOSTED_UI_PREFIX=copilot-g4-auth          # must be globally unique across all of Cognito
ENABLE_GOOGLE_OAUTH=false                 # leave false until the secret has real Google credentials
GOOGLE_OAUTH_SECRET_VERSION_ID=PENDING    # set to the populated secret version ID when enabling Google
BUCKET_PREFIX=copilot-g4                  # must be globally unique across all of S3
VPC_ID=vpc-00000000                       # (lookup) the default VPC
SUBNET_IDS=subnet-aaaaaaa,subnet-bbbbbbb  # (lookup) two default-VPC subnets, different AZs
CF_PREFIX_LIST_ID=pl-00000000             # (lookup) cloudfront origin-facing prefix list, THIS region
BOX_HOST=100.71.161.102                   # box tailnet IP (service :8000)
BUDGET_EMAIL=huyhoang17012006@gmail.com
TS_AUTHKEY=tskey-auth-REPLACE             # tailscale auth key tagged tag:aws-proxy — SECRET
